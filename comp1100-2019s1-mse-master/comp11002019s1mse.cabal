cabal-version:       >= 1.10
name:                comp1100-2019s1-mse
version:             0.1.0.0
synopsis:            COMP1100 2019S1 MSE
copyright:           Copyright (C) 2019 Commonwealth Scientific and Industrial Research Organisation (CSIRO)
category:            Education, Testing
build-type:          Simple

library
  exposed-modules:     ApproximatingTwo
                     , DaysOfTheWeek
                     , Participants
                     , PositiveInts
  build-depends:       base >= 4.8 && < 4.14
  ghc-options:         -Wall
  default-language:    Haskell2010

test-suite ApproximatingTwoTest
  type:                exitcode-stdio-1.0
  main-is:             ApproximatingTwoTest.hs
  ghc-options:         -Wall -threaded
  build-depends:       base
                     , comp1100-2019s1-mse
                     , tasty >= 1.2 && < 1.3
                     , tasty-hunit >= 0.10 && < 0.11
  hs-source-dirs:      Solutions
  default-language:    Haskell2010

test-suite DaysOfTheWeekTest
  type:                exitcode-stdio-1.0
  main-is:             DaysOfTheWeekTest.hs
  ghc-options:         -Wall -threaded
  build-depends:       base
                     , comp1100-2019s1-mse
                     , tasty
                     , tasty-hunit
  hs-source-dirs:      Solutions
  default-language:    Haskell2010

test-suite ParticipantsTest
  type:                exitcode-stdio-1.0
  main-is:             ParticipantsTest.hs
  ghc-options:         -Wall -threaded
  build-depends:       base
                     , comp1100-2019s1-mse
                     , tasty
                     , tasty-hunit
  hs-source-dirs:      Solutions
  default-language:    Haskell2010

test-suite PositiveIntsTest
  type:                exitcode-stdio-1.0
  main-is:             PositiveIntsTest.hs
  ghc-options:         -Wall -threaded
  build-depends:       base
                     , comp1100-2019s1-mse
                     , tasty
                     , tasty-hunit
  hs-source-dirs:      Solutions
  default-language:    Haskell2010
